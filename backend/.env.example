# Environnement et port HTTP de l'API
NODE_ENV=development
PORT=4000

# Connexion applicative MySQL (utilisée par l'API après création de la base)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=misericorde_divine
DB_USER=misericorde_app
DB_PASSWORD=change_me_app_password
DB_CONNECTION_LIMIT=10

# Compte MySQL d'administration uniquement pour npm run migrate
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change_me_root_password

# Session HTTP
SESSION_COOKIE_NAME=md_session
SESSION_DURATION_HOURS=8
ALLOWED_ORIGINS=http://localhost:5173

# Fichiers téléversés (chemin relatif à backend/ si non absolu)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10

# Compte initial créé par npm run seed (mot de passe minimum 8 caractères)
SEED_ADMIN_EMAIL=admin@misericorde.local
SEED_ADMIN_NAME=Gestionnaire
SEED_ADMIN_PASSWORD=change_me_initial_password
